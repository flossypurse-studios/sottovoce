{
  "name": "sottovoce",
  "version": "0.2.0",
  "description": "Sync real, tested code from source repos into your docs — quietly.",
  "keywords": [
    "docs",
    "documentation",
    "snippets",
    "code-samples",
    "sync",
    "markdown",
    "mdx"
  ],
  "license": "MIT",
  "author": "FlossyPurse Studios",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flossypurse-studios/sottovoce.git"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "sottovoce": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsx --test test/*.test.ts",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "fast-glob": "^3.3.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
